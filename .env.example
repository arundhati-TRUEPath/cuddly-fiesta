# ============================================================================
# True Path Navigator — environment variables
#
# Copy this file's contents into Netlify: Site configuration -> Environment
# variables. Never put real values in this file or commit a filled-in .env.
# ============================================================================

# --- Required: makes the bot answer at all ---------------------------------
OPENAI_API_KEY=sk-...

# --- Optional: email handoff (contact form -> staff + visitor) -------------
# Without these, the bot still works and still shows the intake form and
# stores the redundant copy via Netlify Forms — it just won't send emails.
# Get a key at https://resend.com (free tier: 3,000 emails/month, 100/day).
RESEND_API_KEY=re_...

# The "From" address emails are sent from. Must be a domain you've verified
# in Resend (or use Resend's onboarding@resend.dev for testing only).
CONFIRMATION_FROM_EMAIL=noreply@careerpathservices.org

# Team mailboxes the bot routes handoffs to, per Section 4 of the PRD.
# Ask CareerPath for the real addresses (PRD open question A3) — these are
# placeholders.
WORKFIRST_TEAM_EMAIL=workfirst@careerpathservices.org
EMPLOYER_TEAM_EMAIL=keller@careerpathservices.org
RECORDS_TEAM_EMAIL=trina@careerpathservices.org
GENERAL_TEAM_EMAIL=info@careerpathservices.org

# FYI copy sent to the TruePath product team on every handoff (PRD Section 4).
PRODUCT_TEAM_EMAIL=product@crowflies.example

# --- Optional: submit straight into the EXISTING CareerPath Jotform --------
# PRD Section 4 asks the bot to "complete and submit the existing CareerPath
# contact/intake form." We default to our own in-widget form (see README for
# why) plus Netlify Forms as the redundant store. If CareerPath/CrowFlies
# want direct Jotform submission instead, set these two and give us the
# field-ID mapping for the target form (Jotform's field IDs are internal
# numeric IDs, not the visible labels — this needs the form owner or Sean).
JOTFORM_API_KEY=
JOTFORM_FORM_ID=231024293510039

# --- Model settings (see README "Changing the model") -----------------------
MODEL=gpt-4o-mini
